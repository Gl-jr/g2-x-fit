# G² x FIT — переменные окружения
# Скопируй этот файл в .env и заполни перед деплоем

# Секрет для JWT — сгенерируй командой: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=ЗАМЕНИ_НА_СЛУЧАЙНУЮ_СТРОКУ_64_СИМВОЛА

# Срок жизни токена (например: 7d, 30d, 1h)
JWT_EXPIRES=30d

# Порт сервера
PORT=3001

# Разрешённые CORS-домены через запятую (твой домен на хостинге)
# ALLOWED_ORIGINS=https://g2xfit.ru,https://www.g2xfit.ru

# Режим окружения: development | production
NODE_ENV=production
